{
  "name": "pwish-cli",
  "version": "0.1.1",
  "description": "佐糖 AI 设计师（picwish.cn）命令行工具：一句话出电商图、商品图成套出图，自动下载结果",
  "type": "module",
  "bin": {
    "pwish": "bin/pwish.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "skill",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "VERSIONING.md",
    "docs/screenshots"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\"",
    "check": "node scripts/check.js",
    "verify": "npm run check && npm run format:check && npm test",
    "prepublishOnly": "npm run verify",
    "format:check": "node scripts/format-check.js"
  },
  "license": "MIT",
  "keywords": [
    "cli",
    "picwish",
    "ecommerce",
    "image-generation",
    "ai-designer",
    "电商图",
    "佐糖"
  ],
  "author": "pwish-cli contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MisonL/pwish-cli.git"
  },
  "homepage": "https://github.com/MisonL/pwish-cli#readme",
  "bugs": {
    "url": "https://github.com/MisonL/pwish-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
