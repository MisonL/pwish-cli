{
  "name": "pwish-cli",
  "version": "0.18.5",
  "description": "佐糖 AI 设计师（picwish.cn）命令行工具：一句话出电商图、商品图成套出图，自动下载结果",
  "type": "module",
  "bin": {
    "pwish": "bin/pwish.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "skill",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "VERSIONING.md"
  ],
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "check": "node scripts/check.js",
    "verify": "npm run check && npm run format:check && npm test && npm run pack:size",
    "prepublishOnly": "npm run verify",
    "release": "npm run verify && git tag -a v$npm_package_version -m \"pwish-cli $npm_package_version\"",
    "format:check": "node scripts/format-check.js",
    "pack:size": "node scripts/pack-size.js"
  },
  "license": "MIT",
  "keywords": [
    "cli",
    "picwish",
    "ecommerce",
    "image-generation",
    "ai-designer",
    "电商图",
    "佐糖"
  ],
  "author": "pwish-cli contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MisonL/pwish-cli.git"
  },
  "homepage": "https://github.com/MisonL/pwish-cli#readme",
  "bugs": {
    "url": "https://github.com/MisonL/pwish-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
